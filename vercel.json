{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm --prefix apps/web-dashboard run build",
  "installCommand": "npm --prefix apps/web-dashboard install --no-audit --no-fund",
  "devCommand": "npm --prefix apps/web-dashboard run dev",
  "outputDirectory": "apps/web-dashboard/.next",

  "functions": {
    "apps/web-dashboard/app/api/**/*.ts": {
      "maxDuration": 10
    }
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/sync/(.*)",
      "headers": [
        { "key": "Cache-Control",          "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/api/dashboard-data",
      "headers": [
        { "key": "Cache-Control",          "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
